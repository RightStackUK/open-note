---
import Page from '../layouts/Page.astro';
---

<Page title="Not found — Open Note" description="That page does not exist.">
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">404</span>
      <h1 style="font-size: clamp(2rem, 5vw, 2.8rem)">That page is not here.</h1>
      <p class="lede">It may have moved, or it may never have existed. Both happen.</p>
      <div class="hero-actions">
        <a class="button big" href="/">Home</a>
        <a class="button big ghost" href="/docs/getting-started">Docs</a>
        <a class="button big ghost" href="/download">Download</a>
      </div>
    </div>
  </section>
</Page>
